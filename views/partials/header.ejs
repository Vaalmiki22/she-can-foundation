<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>She Can Foundation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/<%- typeof pageCSS !== 'undefined' ? pageCSS : 'main' %>.css"/>
</head>
<body>
<div id="cursor"></div>
<div id="progress-bar"></div>

<nav id="navbar">
  <a href="/" class="nav-logo">She<span>Can</span></a>
  <ul class="nav-links">
    <li><a href="/" class="<%= typeof page !== 'undefined' && page==='home' ? 'active' : '' %>">Home</a></li>
    <li><a href="/about" class="<%= typeof page !== 'undefined' && page==='about' ? 'active' : '' %>">About</a></li>
    <li><a href="/programs" class="<%= typeof page !== 'undefined' && page==='programs' ? 'active' : '' %>">Programs</a></li>
    <li><a href="/blog" class="<%= typeof page !== 'undefined' && page==='blog' ? 'active' : '' %>">Blog</a></li>
    <li><a href="/contact" class="<%= typeof page !== 'undefined' && page==='contact' ? 'active' : '' %>">Contact</a></li>
  </ul>
  <div class="nav-actions">
    <button id="theme-btn" aria-label="Toggle theme">🌙</button>
    <a href="/apply" class="btn-nav">Apply Now</a>
  </div>
  <button class="hamburger" id="hamburger">&#9776;</button>
</nav>

<% if (success && success.length > 0) { %>
  <div class="toast toast-success"><%= success %></div>
<% } %>
<% if (error && error.length > 0) { %>
  <div class="toast toast-error"><%= error %></div>
<% } %>

<%- include('partials/header', {title:'About Us', page:'about', pageCSS:'main'}) %>

<div class="page-header">
  <span class="section-label" style="justify-content:center">Our Story</span>
  <h1>About She Can Foundation</h1>
  <p>A youth-driven NGO dedicated to creating opportunities and lasting impact through education and community.</p>
</div>

<section class="about-section" style="padding-top:6rem">
  <div class="reveal-left">
    <span class="section-label">Who We Are</span>
    <h2 class="section-title">More Than an NGO — We're a Movement</h2>
    <p class="section-sub">Founded in 2020, She Can Foundation started with a simple belief: every young woman deserves a fair chance to learn, grow, and lead. What began as a small community initiative has grown into a multi-state movement touching hundreds of lives.</p>
    <p class="section-sub" style="margin-top:1rem">We work at the intersection of education, technology, and community building — running programs that equip young women with practical skills, mentorship, and the confidence to pursue their ambitions.</p>
    <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
      <a href="/apply" class="btn-primary">Join as Intern</a>
      <a href="/contact" class="btn-outline">Partner With Us</a>
    </div>
  </div>
  <div class="about-img-wrap reveal-right">
    <img src="https://picsum.photos/seed/about2/700/900" alt="She Can Foundation team"/>
    <div class="accent-ring"></div>
  </div>
</section>

<!-- Team / Values -->
<section class="mission-section">
  <span class="section-label reveal" style="justify-content:center">What Drives Us</span>
  <h2 class="section-title reveal">Our Core Values</h2>
  <div class="values-grid">
    <div class="value-card reveal"><div class="v-icon">⚡</div><h3>Empowerment</h3><p>We don't help from above — we stand beside every young woman as she discovers her own power.</p></div>
    <div class="value-card reveal"><div class="v-icon">🌍</div><h3>Inclusivity</h3><p>Talent knows no background. Our doors — physical and digital — are open to everyone.</p></div>
    <div class="value-card reveal"><div class="v-icon">🔥</div><h3>Action</h3><p>We turn awareness into tangible programs, measurable outcomes, and real opportunities.</p></div>
    <div class="value-card reveal"><div class="v-icon">🤝</div><h3>Community</h3><p>Together we grow stronger. Every member lifts the whole community forward.</p></div>
    <div class="value-card reveal"><div class="v-icon">🎓</div><h3>Learning</h3><p>We are perpetual students — always improving, always listening, always growing.</p></div>
    <div class="value-card reveal"><div class="v-icon">🌱</div><h3>Sustainability</h3><p>Our programs are built to last, creating ripples of change for generations to come.</p></div>
  </div>
</section>

<!-- Stats -->
<div class="stats-strip">
  <div class="stat-item"><span class="stat-num">500+</span><span class="stat-label">Lives Impacted</span></div>
  <div class="stat-item"><span class="stat-num">12+</span><span class="stat-label">Programs Running</span></div>
  <div class="stat-item"><span class="stat-num">30+</span><span class="stat-label">Volunteers</span></div>
  <div class="stat-item"><span class="stat-num">8</span><span class="stat-label">States Reached</span></div>
  <div class="stat-item"><span class="stat-num">2020</span><span class="stat-label">Year Founded</span></div>
</div>

<!-- CTA -->
<section class="cta-section">
  <h2 class="reveal">Want to Be Part of Our Story?</h2>
  <p class="reveal">Join She Can Foundation as an intern, volunteer, or partner. Together we create impact that lasts.</p>
  <div class="cta-btns reveal">
    <a href="/apply" class="btn-primary">✦ Apply for Internship</a>
    <a href="/contact" class="btn-outline">Get in Touch</a>
  </div>
</section>

<%- include('partials/footer') %>

<%- include('partials/header', {title: blog.title, page:'blog', pageCSS:'main'}) %>

<style>
.blog-single-wrap{max-width:780px;margin:0 auto;padding:calc(var(--nav-h)+3rem) 5% 5rem}
.blog-hero-img{width:100%;border-radius:20px;aspect-ratio:16/7;object-fit:cover;margin-bottom:2.5rem;box-shadow:var(--shadow)}
.blog-meta{display:flex;align-items:center;gap:1.5rem;margin-bottom:1.5rem;flex-wrap:wrap}
.blog-meta span{font-size:.82rem;color:var(--ink2)}
.blog-meta .cat{background:rgba(192,57,43,.1);color:var(--accent);padding:.25rem .75rem;border-radius:100px;font-weight:700;font-size:.75rem;text-transform:uppercase}
.blog-single-wrap h1{font-family:'Playfair Display',serif;font-size:clamp(2rem,4vw,3rem);font-weight:900;letter-spacing:-.03em;line-height:1.15;margin-bottom:2rem}
.blog-content{font-size:1.05rem;line-height:1.85;color:var(--ink)}
.blog-content p{margin-bottom:1.4rem}
.blog-content h2{font-family:'Playfair Display',serif;font-size:1.5rem;margin:2rem 0 1rem}
.blog-content h3{font-size:1.2rem;margin:1.5rem 0 .7rem}
.blog-divider{border:none;border-top:1px solid var(--border);margin:3rem 0}
.related-section{padding:4rem 5%;background:var(--bg2)}
.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-top:1.5rem;max-width:1200px;margin-left:auto;margin-right:auto}
@media(max-width:700px){.related-grid{grid-template-columns:1fr}}
</style>

<div class="blog-single-wrap">
  <a href="/blog" style="display:inline-flex;align-items:center;gap:.4rem;color:var(--ink2);font-size:.88rem;margin-bottom:2rem;font-weight:500">← Back to Blog</a>
  <div class="blog-meta">
    <span class="cat"><%= blog.category %></span>
    <span>👤 <%= blog.author %></span>
    <span>👁 <%= blog.views %> views</span>
    <span>📅 <%= new Date(blog.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
  </div>
  <h1><%= blog.title %></h1>
  <img src="<%= blog.image %>" alt="<%= blog.title %>" class="blog-hero-img"/>
  <div class="blog-content"><%- blog.content %></div>
</div>

<% if (related.length > 0) { %>
<div class="related-section">
  <div style="max-width:1200px;margin:0 auto;padding:0 5%">
    <h2 class="section-title">Related Articles</h2>
    <div class="related-grid">
      <% related.forEach(r => { %>
      <div class="blog-card">
        <img src="<%= r.image %>" alt="<%= r.title %>"/>
        <div class="blog-card-body">
          <div class="blog-tag"><%= r.category %></div>
          <h3><%= r.title %></h3>
          <p><%= r.excerpt.substring(0,80) %>...</p>
        </div>
        <div class="blog-card-footer">
          <span><%= r.author %></span>
          <a href="/blog/<%= r.slug %>">Read →</a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
